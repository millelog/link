<header>
  <div class="logo-wrapper">
    <a class="logo nav" href="/" title="Cascade Links home">
      <img src="/images/logo.svg" alt="Cascade Online Design" height="28" />
      <span class="co-app-name">Links</span>
    </a>
  </div>
  <nav>
    <ul>
      {{#unless user}}
        {{#unless login_disabled}}
          <li><a class="button primary" href="/login" title="Log in">Log in</a></li>
        {{/unless}}
      {{/unless}}
      {{#if user}}
        <li><a class="nav" href="/settings" title="Settings">Settings</a></li>
        {{#if isAdmin}}
          <li><a class="nav" href="/admin" title="Admin">Admin</a></li>
        {{/if}}
        <li><a class="nav" href="/logout" title="Log out">Log out</a></li>
      {{/if}}
    </ul>
  </nav>
</header>
